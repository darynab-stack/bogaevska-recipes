# Секретний ключ Django. Згенеруйте свій командою:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True лише для локальної розробки
DEBUG=True

# Адреси, на яких може працювати сервер (через кому)
ALLOWED_HOSTS=127.0.0.1,localhost

# Адреси фронтенду, яким дозволено звертатися до API (через кому)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Скільки живуть JWT токени
ACCESS_TOKEN_LIFETIME_MINUTES=5
REFRESH_TOKEN_LIFETIME_DAYS=1

# Рівень логування: DEBUG, INFO, WARNING або ERROR
LOG_LEVEL=INFO
